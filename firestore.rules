rules_version = '2';

/**
 * SECURITY FIX — the deployed firestore.rules has `allow read, write: if
 * true` on every single collection, including admin_ai_keys and
 * credentials (API keys). Firebase client config is not secret by
 * design — it ships in the frontend bundle. With no rules, anyone who
 * opens devtools on the live site can read or overwrite every company's
 * credentials directly, bypassing server.ts entirely, including every
 * auth/permission check built in this engagement. This replaces every
 * rule with role-based access checked against the SAME persona model
 * server.ts already uses (super_admin / company_admin / team_member),
 * looked up via a Firestore get() against /users/{uid} — not a second,
 * divergent authorization system.
 *
 * Collection names match the REAL schema found in the deployed rules —
 * not renamed to match an earlier, differently-named design.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isSuperAdmin() {
      return isSignedIn() && userDoc().data.role == 'super_admin';
    }
    function isCompanyAdminOf(companyId) {
      return isSignedIn()
        && userDoc().data.role == 'company_admin'
        && userDoc().data.companyId == companyId;
    }
    function isMemberOf(companyId) {
      return isSignedIn() && userDoc().data.companyId == companyId;
    }

    // ---- Users: read/write own profile; super_admin can read/write any ----
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // ---- Trials: owner or super_admin only ----
    match /user_trials/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    // ---- Platform-level admin API keys: super_admin ONLY, no exceptions ----
    match /admin_ai_keys/{keyId} {
      allow read, write: if isSuperAdmin();
    }

    // ---- Contact inquiries: public can CREATE (a contact form), nobody
    //      can read/list except super_admin — prevents scraping submitted
    //      contact details ----
    match /contact_inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // ---- Credentials vault (BYOK company API keys) — scoped strictly to
    //      that company's own admin, plus super_admin. This is the
    //      single most sensitive collection in the whole schema. ----
    match /credentials/{providerId} {
      allow read, write: if isSuperAdmin() || isCompanyAdminOf(resource.data.companyId);
    }

    // ---- SMTP settings: super_admin only ----
    match /smtp_settings/{settingsId} {
      allow read, write: if isSuperAdmin();
    }

    // ---- Email logs / audit logs: written server-side only via the
    //      Admin SDK, which bypasses these rules entirely — client-side
    //      writes are never legitimate for these two collections.
    //      Read access is admin-only. ----
    match /email_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ---- Dispatch ledger / task history: scoped to the owning user or
    //      their company admin ----
    match /dispatch_ledger/{ledgerId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isCompanyAdminOf(resource.data.companyId) || isSuperAdmin());
      allow write: if false; // server-side only, via Admin SDK
    }

    // ---- Context/chat sessions: strictly the owning user, or super_admin
    //      for support purposes ----
    match /context_sessions/{sessionId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // Firestore rules do NOT cascade to subcollections — an unruled
      // subcollection is denied by default under rules_version '2', but
      // stating it explicitly here rather than relying on silent
      // default-deny, since that's exactly the kind of implicit
      // behavior that led to the top-level "if true" problem in the
      // first place going unnoticed.
      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (get(/databases/$(database)/documents/context_sessions/$(sessionId)).data.userId == request.auth.uid || isSuperAdmin());
      }
    }

    // ---- Companies: members can read their own company; only that
    //      company's admin (or super_admin) can write ----
    match /companies/{companyId} {
      allow read: if isMemberOf(companyId) || isSuperAdmin();
      allow write: if isCompanyAdminOf(companyId) || isSuperAdmin();
    }

    // ---- Teams: same pattern as companies, scoped one level down ----
    match /teams/{teamId} {
      allow read: if isSignedIn() && (isMemberOf(resource.data.companyId) || isSuperAdmin());
      allow write: if isSignedIn() && (isCompanyAdminOf(resource.data.companyId) || isSuperAdmin());
    }

    // ---- Email templates: super_admin only (these define what gets
    //      sent to every user on the platform — not a per-company
    //      resource) ----
    match /email_templates/{templateId} {
      allow read, write: if isSuperAdmin();
    }

    // ---- Model catalog: MISSING from the originally reviewed rules
    //      entirely — POST /api/admin/models writes to an in-memory
    //      array only, with no persistence and no auth check at all.
    //      Every signed-in user needs to READ this (routing decisions
    //      depend on it); only super_admin can add/modify entries. ----
    match /model_catalog/{modelId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
